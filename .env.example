# mail-agent 로컬 실행 환경변수 — 이 파일을 .env로 복사해 사용하세요.
# .env는 .gitignore에 포함되어 커밋되지 않습니다. 실제 키는 절대 커밋하지 마세요.

# OpenRouter API 키 (비우면 LLM 은 캐시/기본 메시지 폴백으로 동작 — 지시-017)
OPENROUTER_API_KEY=

# OpenRouter 모델 ID (비우면 anthropic/claude-sonnet-4-5)
OPENROUTER_MODEL=anthropic/claude-sonnet-4-5

# 분류AI(scripts/classify.py) 전용 설정 (지시-022) — 비우면 아래 기본값 사용
# 분류 전용 모델 (기본: deepseek-v4-flash-0731, OPENROUTER_MODEL 우선)
CLASSIFIER_MODEL=deepseek/deepseek-v4-flash-0731
# 분류 요청 온도 (결정 재현성, 기본 0.0)
CLASSIFIER_TEMPERATURE=0.0
# 분류 응답 max_tokens 상한 (기본 4096)
CLASSIFIER_MAX_TOKENS=4096
# 청크 크기 — 1회 LLM 호출에 넣을 메일 수 (기본 40)
CLASSIFIER_CHUNK_SIZE=40
# LLM 실패 시 부분 재시도 횟수 (기본 1)
CLASSIFIER_MAX_RETRIES=1

# uvicorn 포트 (run.ps1 이 읽음, 기본 8765)
PORT=8765